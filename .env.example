# Local development: no external account is required.
APP_URL=http://127.0.0.1:3000
DATA_DIRECTORY=.data/nqta
DEMO_MODE=true
# Existing contact flow is the default. Set recovery-key for password + saved-key accounts.
AUTH_MODE=verified-contact

# Hosted testing: a dedicated synthetic PostgreSQL database and HTTPS origin are required.
# Keep NODE_ENV=production. HOSTED_TEST_MODE is the explicit opt-in for displayed test codes.
# NODE_ENV=production
# HOSTED_TEST_MODE=true
# APP_URL=https://your-assigned-host.example
# DATABASE_URL=postgresql://user:password@host:5432/nqta_test?sslmode=require
# SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# TEST_ACCESS_PASSWORD=generate-a-random-password-of-at-least-16-characters
# HTTP Basic access uses username nqta and TEST_ACCESS_PASSWORD.
# See docs/hosted-testing.md and render.yaml. Never commit real secrets.

# Real production: use docs/production-environment.example for the complete template.
# Hosted testing must be off, with a clean PostgreSQL database.
# Recovery-key mode does not use message delivery for account access.
# NODE_ENV=production
# HOSTED_TEST_MODE=false
# DEMO_MODE=false
# AUTH_MODE=recovery-key
# DATABASE_URL=postgresql://user:password@host:5432/nqta?sslmode=require
# SESSION_SECRET=replace-with-a-cryptographically-random-value
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# SMS_ALLOWED_PREFIXES=212
# SMS_DAILY_LIMIT=100
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Nqta <accounts@your-verified-domain.example>

# Native Wallet: optional, hidden until genuine credentials validate.
# See docs/wallet-setup.md. Credentials belong only on the server.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=
# GOOGLE_WALLET_PUBLISHING_ACCESS=approved
# APPLE_WALLET_PASS_TYPE_ID=
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_SIGNER_CERT_BASE64=
# APPLE_WALLET_SIGNER_KEY_BASE64=
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# APPLE_WALLET_WWDR_CERT_BASE64=
# APPLE_WALLET_AUTH_SECRET=

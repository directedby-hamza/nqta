# Local development: no external account is required.
APP_URL=http://127.0.0.1:3000
DATA_DIRECTORY=.data/nqta
DEMO_MODE=true

# Hosted testing: a dedicated synthetic PostgreSQL database and HTTPS origin are required.
# Keep NODE_ENV=production. HOSTED_TEST_MODE is the explicit opt-in for displayed test codes.
# NODE_ENV=production
# HOSTED_TEST_MODE=true
# APP_URL=https://your-assigned-host.example
# DATABASE_URL=postgresql://user:password@host:5432/nqta_test?sslmode=require
# SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# TEST_ACCESS_PASSWORD=generate-a-random-password-of-at-least-16-characters
# HTTP Basic access uses username nqta and TEST_ACCESS_PASSWORD.
# See docs/hosted-testing.md and render.yaml. Never commit real secrets.

# Real production: hosted testing must be off, with PostgreSQL and real SMS configured.
# NODE_ENV=production
# HOSTED_TEST_MODE=false
# DEMO_MODE=false
# DATABASE_URL=postgresql://user:password@host:5432/nqta
# SESSION_SECRET=replace-with-a-cryptographically-random-value
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
